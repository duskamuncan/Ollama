	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:Substation rdfs:label "Substation"@en ;
	rdfs:subClassOf cim:EquipmentContainer ;
	rdfs:comment "A collection of equipment for purposes other than generation or utilization, through which electric energy in bulk is passed for the purposes of switching or modifying its characteristics. "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Core ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:Substation.VoltageLevels rdfs:label "VoltageLevels"@en ;
	rdfs:comment "The voltage levels within this substation."^^rdf:XMLLiteral ;
	rdfs:domain cim:Substation ;
	rdfs:range cim:VoltageLevel ;
	cims:inverseRoleName cim:VoltageLevel.Substation ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:VoltageLevel.Substation rdfs:label "Substation"@en ;
	rdfs:comment "The substation of the voltage level."^^rdf:XMLLiteral ;
	rdfs:domain cim:VoltageLevel ;
	rdfs:range cim:Substation ;
	cims:inverseRoleName cim:Substation.VoltageLevels ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:Terminal rdfs:label "Terminal"@en ;
	rdfs:subClassOf cim:ACDCTerminal ;
	rdfs:comment "An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Core ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:Terminal.phases cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "phases"@en ;
	rdfs:domain cim:Terminal ;
	rdfs:range cim:PhaseCode ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Represents the normal network phasing condition.
If the attribute is missing three phases (ABC or ABCN) shall be assumed."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:RegulatingControl.Terminal rdfs:label "Terminal"@en ;
	rdfs:comment "The controls regulating this terminal."^^rdf:XMLLiteral ;
	rdfs:domain cim:RegulatingControl ;
	rdfs:range cim:Terminal ;
	cims:inverseRoleName cim:Terminal.RegulatingControl ;
	cims:multiplicity cims:M:1..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:Terminal.RegulatingControl rdfs:label "RegulatingControl"@en ;
	rdfs:comment "The terminal associated with this regulating control.  The terminal is associated instead of a node, since the terminal could connect into either a topological node (bus in bus-branch model) or a connectivity node (detailed switch model).  Sometimes it is useful to model regulation at a terminal of a bus bar object since the bus bar can be present in both a bus-branch model or a model with switch detail."^^rdf:XMLLiteral ;
	rdfs:domain cim:Terminal ;
	rdfs:range cim:RegulatingControl ;
	cims:inverseRoleName cim:RegulatingControl.Terminal ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:TieFlow.Terminal rdfs:label "Terminal"@en ;
	rdfs:comment "The terminal to which this tie flow belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:TieFlow ;
	rdfs:range cim:Terminal ;
	cims:inverseRoleName cim:Terminal.TieFlow ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:Terminal.TieFlow rdfs:label "TieFlow"@en ;
	rdfs:comment "The control area tie flows to which this terminal associates."^^rdf:XMLLiteral ;
	rdfs:domain cim:Terminal ;
	rdfs:range cim:TieFlow ;
	cims:inverseRoleName cim:TieFlow.Terminal ;
	cims:multiplicity cims:M:0..2 ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:TransformerEnd.Terminal rdfs:label "Terminal"@en ;
	rdfs:comment "Terminal of the power transformer to which this transformer end belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:TransformerEnd ;
	rdfs:range cim:Terminal ;
	cims:inverseRoleName cim:Terminal.TransformerEnd ;
	cims:multiplicity cims:M:1..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:Terminal.TransformerEnd rdfs:label "TransformerEnd"@en ;
	rdfs:comment "All transformer ends connected at this terminal."^^rdf:XMLLiteral ;
	rdfs:domain cim:Terminal ;
	rdfs:range cim:TransformerEnd ;
	cims:inverseRoleName cim:TransformerEnd.Terminal ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:VoltageLevel rdfs:label "VoltageLevel"@en ;
	rdfs:subClassOf cim:EquipmentContainer ;
	rdfs:comment "A collection of equipment at one common system voltage forming a switchgear. The equipment typically consist of breakers, busbars, instrumentation, control, regulation and protection devices as well as assemblies of all these."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Core ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:VoltageLevel.highVoltageLimit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "highVoltageLimit"@en ;
	rdfs:domain cim:VoltageLevel ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The bus bar's high voltage limit"^^rdf:XMLLiteral ;
	a rdf:Property .

cim:VoltageLevel.lowVoltageLimit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "lowVoltageLimit"@en ;
	rdfs:domain cim:VoltageLevel ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The bus bar's low voltage limit"^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Package_OperationalLimits rdfs:label "OperationalLimits"@en ;
	a cims:ClassCategory ;
	rdfs:comment "The OperationalLimits package models a specification of limits associated with equipment and other operational entities."^^rdf:XMLLiteral .

cim:CurrentLimit rdfs:label "CurrentLimit"@en ;
	rdfs:subClassOf cim:OperationalLimit ;
	rdfs:comment "Operational limit on current. "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:CurrentLimit.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:CurrentLimit ;
	cims:dataType cim:CurrentFlow ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Limit on current flow."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LimitTypeKind rdfs:label "LimitTypeKind"@en ;
	rdfs:comment "The enumeration defines the kinds of the limit types."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> , "Entsoe" ;
	a rdfs:Class .

cim:LimitTypeKind.patl rdfs:label "patl"@en ;
	rdfs:comment """The Permanent Admissible Transmission Loading (PATL) is the loading in Amps, MVA or MW that can be accepted by a network branch for an unlimited duration without any risk for the material.
The duration attribute is not used and shall be excluded for the PATL limit type. Hence only one limit value exists for the PATL type."""^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.patlt rdfs:label "patlt"@en ;
	rdfs:comment "Permanent Admissible Transmission Loading Threshold  (PATLT) is a value in engineering units defined for PATL and calculated using percentage less than 100 of the PATL type intended to alert operators of an arising condition. The percentage should be given in the name of the OperationalLimitSet. The aceptableDuration is another way to express the severity of the limit."^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.tatl rdfs:label "tatl"@en ;
	rdfs:comment """Temporarily Admissible Transmission Loading (TATL) which is the loading in Amps, MVA or MW that can be accepted by a branch for a certain limited duration.
The TATL can be defined in different ways:
<ul>
	<li>as a fixed percentage of the PATL for a given time (for example, 115% of the PATL that can be accepted during 15 minutes),</li>
</ul>
<ul>
	<li>pairs of TATL type and Duration calculated for each line taking into account its particular configuration and conditions of functioning (for example, it can define a TATL acceptable during 20 minutes and another one acceptable during 10 minutes).</li>
</ul>
Such a definition of TATL can depend on the initial operating conditions of the network element (sag situation of a line).
The duration attribute can be used define several TATL limit types. Hence multiple TATL limit values may exist having different durations."""^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.tc rdfs:label "tc"@en ;
	rdfs:comment """Tripping Current (TC) is the ultimate intensity without any delay. It is defined as the threshold the line will trip without any possible remedial actions.
The tripping of the network element is ordered by protections against short circuits or by overload protections, but in any case, the activation delay of these protections is not compatible with the reaction delay of an operator (less than one minute).
The duration is always zero and the duration attribute may be left out. Hence only one limit value exists for the TC type."""^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.tct rdfs:label "tct"@en ;
	rdfs:comment "Tripping Current Threshold  (TCT) is a value in engineering units defined for TC and calculated using percentage less than 100 of the TC type intended to alert operators of an arising condition. The percentage should be given in the name of the OperationalLimitSet. The aceptableDuration is another way to express the severity of the limit."^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.highVoltage rdfs:label "highVoltage"@en ;
	rdfs:comment """Referring to the rating of the equipments, a voltage too high can lead to accelerated ageing or the destruction of the equipment. 
This limit type may or may not have duration."""^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:LimitTypeKind.lowVoltage rdfs:label "lowVoltage"@en ;
	rdfs:comment """A too low voltage can disturb the normal operation of some protections and transformer equipped with on-load tap changers, electronic power devices or can affect the behaviour of the auxiliaries of generation units.
This limit type may or may not have duration."""^^rdf:XMLLiteral ;
	a cim:LimitTypeKind .

cim:OperationalLimit rdfs:label "OperationalLimit"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment """A value associated with a specific kind of limit. 
The sub class value attribute shall be positive. 
The sub class value attribute is inversely proportional to OperationalLimitType.acceptableDuration (acceptableDuration for short). A pair of value_x and acceptableDuration_x are related to each other as follows:
if value_1 &gt; value_2 &gt; value_3 &gt;... then
acceptableDuration_1 &lt; acceptableDuration_2 &lt; acceptableDuration_3 &lt; ...
A value_x with direction=\"high\" shall be greater than a value_y with direction=\"low\"."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	a rdfs:Class .

cim:OperationalLimitSet.OperationalLimitValue rdfs:label "OperationalLimitValue"@en ;
	rdfs:comment "The limit set to which the limit values belong."^^rdf:XMLLiteral ;
	rdfs:domain cim:OperationalLimitSet ;
	rdfs:range cim:OperationalLimit ;
	cims:inverseRoleName cim:OperationalLimit.OperationalLimitSet ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:OperationalLimit.OperationalLimitSet rdfs:label "OperationalLimitSet"@en ;
	rdfs:comment "Values of equipment limits."^^rdf:XMLLiteral ;
	rdfs:domain cim:OperationalLimit ;
	rdfs:range cim:OperationalLimitSet ;
	cims:inverseRoleName cim:OperationalLimitSet.OperationalLimitValue ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:OperationalLimit.OperationalLimitType rdfs:label "OperationalLimitType"@en ;
	rdfs:comment "The limit type associated with this limit."^^rdf:XMLLiteral ;
	rdfs:domain cim:OperationalLimit ;
	rdfs:range cim:OperationalLimitType ;
	cims:inverseRoleName cim:OperationalLimitType.OperationalLimit ;
	cims:multiplicity cims:M:1..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:OperationalLimitType.OperationalLimit rdfs:label "OperationalLimit"@en ;
	rdfs:comment "The operational limits associated with this type of limit."^^rdf:XMLLiteral ;
	rdfs:domain cim:OperationalLimitType ;
	rdfs:range cim:OperationalLimit ;
	cims:inverseRoleName cim:OperationalLimit.OperationalLimitType ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:OperationalLimitDirectionKind rdfs:label "OperationalLimitDirectionKind"@en ;
	rdfs:comment "The direction attribute describes the side of  a limit that is a violation."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:OperationalLimitDirectionKind.high rdfs:label "high"@en ;
	rdfs:comment "High means that a monitored value above the limit value is a violation.   If applied to a terminal flow, the positive direction is into the terminal."^^rdf:XMLLiteral ;
	a cim:OperationalLimitDirectionKind .

cim:OperationalLimitDirectionKind.low rdfs:label "low"@en ;
	rdfs:comment "Low means a monitored value below the limit is a violation.  If applied to a terminal flow, the positive direction is into the terminal."^^rdf:XMLLiteral ;
	a cim:OperationalLimitDirectionKind .

cim:OperationalLimitDirectionKind.absoluteValue rdfs:label "absoluteValue"@en ;
	rdfs:comment "An absoluteValue limit means that a monitored absolute value above the limit value is a violation."^^rdf:XMLLiteral ;
	a cim:OperationalLimitDirectionKind .

cim:OperationalLimitSet rdfs:label "OperationalLimitSet"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "A set of limits associated with equipment.  Sets of limits might apply to a specific temperature, or season for example. A set of limits may contain different severities of limit levels that would apply to the same equipment. The set may contain limits of different types such as apparent power and current limits or high and low voltage limits  that are logically applied together as a set."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:OperationalLimitType rdfs:label "OperationalLimitType"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "The operational meaning of a category of limits."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:OperationalLimitType.acceptableDuration cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "acceptableDuration"@en ;
	rdfs:domain cim:OperationalLimitType ;
	cims:dataType cim:Seconds ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The nominal acceptable duration of the limit.  Limits are commonly expressed in terms of the a time limit for which the limit is normally acceptable.   The actual acceptable duration of a specific limit may depend on other local factors such as temperature or wind speed."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:OperationalLimitType.limitType cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "limitType"@en ;
	rdfs:domain cim:OperationalLimitType ;
	rdfs:range cim:LimitTypeKind ;
	cims:multiplicity cims:M:1..1 ;
	cims:stereotype "Entsoe" ;
	rdfs:comment "Types of limits defined in the ENTSO-E Operational Handbook Policy 3."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:OperationalLimitType.direction cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "direction"@en ;
	rdfs:domain cim:OperationalLimitType ;
	rdfs:range cim:OperationalLimitDirectionKind ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The direction of the limit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:VoltageLimit rdfs:label "VoltageLimit"@en ;
	rdfs:subClassOf cim:OperationalLimit ;
	rdfs:comment "Operational limit applied to voltage."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_OperationalLimits ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:VoltageLimit.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:VoltageLimit ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Limit on voltage. High or low limit nature of the limit depends upon the properties of the operational limit type."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Package_Wires rdfs:label "Wires"@en ;
	a cims:ClassCategory ;
	rdfs:comment "An extension to the Core and Topology package that models information on the electrical characteristics of Transmission and Distribution networks. This package is used by network applications such as State Estimation, Load Flow and Optimal Power Flow.  "^^rdf:XMLLiteral .

cim:ACLineSegment rdfs:label "ACLineSegment"@en ;
	rdfs:subClassOf cim:Conductor ;
	rdfs:comment """A wire or combination of wires, with consistent electrical characteristics, building a single electrical system, used to carry alternating current between points in the power system.
For symmetrical, transposed 3ph lines, it is sufficient to use  attributes of the line segment, which describe impedances and admittances for the entire length of the segment.  Additionally impedances can be computed by using length and associated per length impedances.
The BaseVoltage at the two ends of ACLineSegments in a Line shall have the same BaseVoltage.nominalVoltage. However, boundary lines  may have slightly different BaseVoltage.nominalVoltages and  variation is allowed. Larger voltage difference in general requires use of an equivalent branch."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:Susceptance rdfs:label "Susceptance"@en ;
	rdfs:comment "Imaginary part of admittance."^^rdf:XMLLiteral ;
	cims:stereotype "CIMDatatype" ;
	cims:belongsToCategory cim:Package_DomainProfile ;
	a rdfs:Class .

cim:Susceptance.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:Susceptance ;
	cims:dataType cim:Float ;
	cims:multiplicity cims:M:0..1 ;
	a rdf:Property .

cim:Susceptance.unit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "unit"@en ;
	rdfs:domain cim:Susceptance ;
	rdfs:range cim:UnitSymbol ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x59 .

_:node1jgf556j7x59 rdfs:Literal "S" .

cim:Susceptance.unit a rdf:Property .

cim:Susceptance.multiplier cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "multiplier"@en ;
	rdfs:domain cim:Susceptance ;
	rdfs:range cim:UnitMultiplier ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x60 .

_:node1jgf556j7x60 rdfs:Literal "none" .

cim:Susceptance.multiplier a rdf:Property .

cim:ACLineSegment.bch cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "bch"@en ;
	rdfs:domain cim:ACLineSegment ;
	cims:dataType cim:Susceptance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence shunt (charging) susceptance, uniformly distributed, of the entire line section.  This value represents the full charging over the full length of the line."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Conductance rdfs:label "Conductance"@en ;
	rdfs:comment "Factor by which voltage must be multiplied to give corresponding power lost from a circuit. Real part of admittance."^^rdf:XMLLiteral ;
	cims:stereotype "CIMDatatype" ;
	cims:belongsToCategory cim:Package_DomainProfile ;
	a rdfs:Class .

cim:Conductance.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:Conductance ;
	cims:dataType cim:Float ;
	cims:multiplicity cims:M:0..1 ;
	a rdf:Property .

cim:Conductance.unit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "unit"@en ;
	rdfs:domain cim:Conductance ;
	rdfs:range cim:UnitSymbol ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x61 .

_:node1jgf556j7x61 rdfs:Literal "S" .

cim:Conductance.unit a rdf:Property .

cim:Conductance.multiplier cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "multiplier"@en ;
	rdfs:domain cim:Conductance ;
	rdfs:range cim:UnitMultiplier ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x62 .

_:node1jgf556j7x62 rdfs:Literal "none" .

cim:Conductance.multiplier a rdf:Property .

cim:ACLineSegment.gch cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "gch"@en ;
	rdfs:domain cim:ACLineSegment ;
	cims:dataType cim:Conductance ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Positive sequence shunt (charging) conductance, uniformly distributed, of the entire line section."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ACLineSegment.r cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r"@en ;
	rdfs:domain cim:ACLineSegment ;
	cims:dataType cim:Resistance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence series resistance of the entire line section."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Temperature rdfs:label "Temperature"@en ;
	rdfs:comment "Value of temperature in degrees Celsius."^^rdf:XMLLiteral ;
	cims:stereotype "CIMDatatype" ;
	cims:belongsToCategory cim:Package_DomainProfile ;
	a rdfs:Class .

cim:Temperature.multiplier cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "multiplier"@en ;
	rdfs:domain cim:Temperature ;
	rdfs:range cim:UnitMultiplier ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x63 .

_:node1jgf556j7x63 rdfs:Literal "none" .

cim:Temperature.multiplier a rdf:Property .

cim:Temperature.unit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "unit"@en ;
	rdfs:domain cim:Temperature ;
	rdfs:range cim:UnitSymbol ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x64 .

_:node1jgf556j7x64 rdfs:Literal "degC" .

cim:Temperature.unit a rdf:Property .

cim:Temperature.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:Temperature ;
	cims:dataType cim:Float ;
	cims:multiplicity cims:M:0..1 ;
	a rdf:Property .

cim:ACLineSegment.x cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x"@en ;
	rdfs:domain cim:ACLineSegment ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence series reactance of the entire line section."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:AsynchronousMachine rdfs:label "AsynchronousMachine"@en ;
	rdfs:subClassOf cim:RotatingMachine ;
	rdfs:comment "A rotating machine whose shaft rotates asynchronously with the electrical field.  Also known as an induction machine with no external connection to the rotor windings, e.g squirrel-cage induction machine."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
