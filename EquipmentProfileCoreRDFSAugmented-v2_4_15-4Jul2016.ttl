cim:HydroEnergyConversionKind.pumpAndGenerator rdfs:label "pumpAndGenerator"@en ;
	rdfs:comment "Able to both generate power and pump water for energy storage."^^rdf:XMLLiteral ;
	a cim:HydroEnergyConversionKind .

