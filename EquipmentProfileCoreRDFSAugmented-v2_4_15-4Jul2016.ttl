cim:Seconds.unit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "unit"@en ;
	rdfs:domain cim:Seconds ;
	rdfs:range cim:UnitSymbol ;
