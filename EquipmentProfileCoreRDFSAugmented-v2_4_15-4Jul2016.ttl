cim:HydroPowerPlant rdfs:label "HydroPowerPlant"@en ;
	rdfs:subClassOf cim:PowerSystemResource ;
	rdfs:comment "A hydro power station which can generate or pump. When generating, the generator turbines receive water from an upper reservoir. When pumping, the pumps receive their water from a lower reservoir."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Production ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:HydroPowerPlant.hydroPlantStorageType cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "hydroPlantStorageType"@en ;
	rdfs:domain cim:HydroPowerPlant ;
	rdfs:range cim:HydroPlantStorageKind ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The type of hydro power plant water storage."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:HydroPowerPlant.HydroPumps rdfs:label "HydroPumps"@en ;
	rdfs:comment "The hydro pump may be a member of a pumped storage plant or a pump for distributing water."^^rdf:XMLLiteral ;
	rdfs:domain cim:HydroPowerPlant ;
	rdfs:range cim:HydroPump ;
