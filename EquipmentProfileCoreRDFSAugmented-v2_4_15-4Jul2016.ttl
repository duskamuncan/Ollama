cim:IdentifiedObject.description cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "description"@en ;
	rdfs:domain cim:IdentifiedObject ;
	cims:dataType cim:String ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:IdentifiedObject.energyIdentCodeEic cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "energyIdentCodeEic"@en ;
	rdfs:domain cim:IdentifiedObject ;
	cims:dataType cim:String ;
	cims:multiplicity cims:M:0..1 ;
	cims:stereotype "Entsoe" ;
	rdfs:comment """The attribute is used for an exchange of the EIC code (Energy identification Code). The length of the string is 16 characters as defined by the EIC code.
References: 
<ul>
	<li>Local issuing offices for EIC: <a href=\"https://www.entsoe.eu/publications/edi-library/links-to-eic-websites/\"><font color=\"#0000ff\"><u>https://www.entsoe.eu/publications/edi-library/links-to-eic-websites/</u></font></a> </li>
	<li>EIC description: <a href=\"https://www.entsoe.eu/index.php?id=73&amp;libCat=eic\"><font color=\"#0000ff\"><u>https://www.entsoe.eu/index.php?id=73&amp;libCat=eic</u></font></a> .</li>
</ul>"""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:IdentifiedObject.mRID cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "mRID"@en ;
	rdfs:domain cim:IdentifiedObject ;
	cims:dataType cim:String ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Master resource identifier issued by a model authority. The mRID is globally unique within an exchange context. Global uniqueness is easily achieved by using a UUID,  as specified in RFC 4122, for the mRID.  The use of UUID is strongly recommended.
For CIMXML data files in RDF syntax conforming to IEC 61970-552 Edition 1, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:IdentifiedObject.name cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "name"@en ;
	rdfs:domain cim:IdentifiedObject ;
	cims:dataType cim:String ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The name is any free human readable and possibly non unique text naming the object."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:IdentifiedObject.shortName cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "shortName"@en ;
	rdfs:domain cim:IdentifiedObject ;
	cims:dataType cim:String ;
	cims:multiplicity cims:M:0..1 ;
	cims:stereotype "Entsoe" ;
	rdfs:comment "The attribute is used for an exchange of a human readable short name with length of the string 12 characters maximum."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerSystemResource rdfs:label "PowerSystemResource"@en ;
