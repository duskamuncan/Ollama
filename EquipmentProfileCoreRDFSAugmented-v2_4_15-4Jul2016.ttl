	rdfs:comment "Generic user of energy - a  point of consumption on the power system model."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

