	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:HydroPump.HydroPowerPlant rdfs:label "HydroPowerPlant"@en ;
	rdfs:comment "The hydro pump may be a member of a pumped storage plant or a pump for distributing water."^^rdf:XMLLiteral ;
	rdfs:domain cim:HydroPump ;
	rdfs:range cim:HydroPowerPlant ;
	cims:inverseRoleName cim:HydroPowerPlant.HydroPumps ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:HydroPump rdfs:label "HydroPump"@en ;
	rdfs:subClassOf cim:Equipment ;
	rdfs:comment "A synchronous motor-driven pump, typically associated with a pumped storage plant."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Production ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
