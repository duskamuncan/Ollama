cim:Package_Topology rdfs:label "Topology"@en ;
	a cims:ClassCategory .

cim:BusNameMarker rdfs:label "BusNameMarker"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "Used to apply user standard names to topology buses. Typically used for \"bus/branch\" case generation. Associated with one or more terminals that are normally connected with the bus name.    The associated terminals are normally connected by non-retained switches. For a ring bus station configuration, all busbar terminals in the ring are typically associated.   For a breaker and a half scheme, both busbars would normally be associated.  For a ring bus, all busbars would normally be associated.  For a \"straight\" busbar configuration, normally only the main terminal at the busbar would be associated.  "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Topology ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:BusNameMarker.priority cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "priority"@en ;
	rdfs:domain cim:BusNameMarker ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Priority of bus name marker for use as topology bus name.  Use 0 for don t care.  Use 1 for highest priority.  Use 2 as priority is less than 1 and so on."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ReportingGroup.BusNameMarker rdfs:label "BusNameMarker"@en ;
	rdfs:comment "The reporting group to which this bus name marker belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:ReportingGroup ;
	rdfs:range cim:BusNameMarker ;
	cims:inverseRoleName cim:BusNameMarker.ReportingGroup ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:BusNameMarker.ReportingGroup rdfs:label "ReportingGroup"@en ;
	rdfs:comment "The bus name markers that belong to this reporting group."^^rdf:XMLLiteral ;
	rdfs:domain cim:BusNameMarker ;
	rdfs:range cim:ReportingGroup ;
	cims:inverseRoleName cim:ReportingGroup.BusNameMarker ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:BusNameMarker.Terminal rdfs:label "Terminal"@en ;
	rdfs:comment "The terminals associated with this bus name marker."^^rdf:XMLLiteral ;
	rdfs:domain cim:BusNameMarker ;
	rdfs:range cim:ACDCTerminal ;
	cims:inverseRoleName cim:ACDCTerminal.BusNameMarker ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:ACDCTerminal.BusNameMarker rdfs:label "BusNameMarker"@en ;
