cim:GeneratingUnit rdfs:label "GeneratingUnit"@en ;
	rdfs:subClassOf cim:Equipment ;
	rdfs:comment "A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Production ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:GeneratingUnit.genControlSource cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "genControlSource"@en ;
	rdfs:domain cim:GeneratingUnit ;
	rdfs:range cim:GeneratorControlSource ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The source of controls for a generating unit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratorControlSource rdfs:label "GeneratorControlSource"@en ;
	rdfs:comment "The source of controls for a generating unit."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Production ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:GeneratorControlSource.unavailable rdfs:label "unavailable"@en ;
	rdfs:comment "Not available."^^rdf:XMLLiteral ;
	a cim:GeneratorControlSource .

cim:GeneratorControlSource.offAGC rdfs:label "offAGC"@en ;
	rdfs:comment "Off of automatic generation control (AGC)."^^rdf:XMLLiteral ;
	a cim:GeneratorControlSource .

cim:GeneratorControlSource.onAGC rdfs:label "onAGC"@en ;
	rdfs:comment "On automatic generation control (AGC)."^^rdf:XMLLiteral ;
	a cim:GeneratorControlSource .

cim:GeneratorControlSource.plantControl rdfs:label "plantControl"@en ;
	rdfs:comment "Plant is controlling."^^rdf:XMLLiteral ;
	a cim:GeneratorControlSource .

cim:GeneratingUnit.governorSCD cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "governorSCD"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Governor Speed Changer Droop.   This is the change in generator power output divided by the change in frequency normalized by the nominal power of the generator and the nominal frequency and expressed in percent and negated. A positive value of speed change droop provides additional generator output upon a drop in frequency."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.initialP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "initialP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Default initial active power  which is used to store a powerflow result for the initial active power for this unit in this network configuration."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.longPF cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "longPF"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Generating unit long term economic participation factor."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.maximumAllowableSpinningReserve cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maximumAllowableSpinningReserve"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Maximum allowable spinning reserve. Spinning reserve will never be considered greater than this value regardless of the current operating point."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.maxOperatingP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maxOperatingP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "This is the maximum operating active power limit the dispatcher can enter for this unit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.minOperatingP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "minOperatingP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "This is the minimum operating active power limit the dispatcher can enter for this unit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.nominalP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "nominalP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """The nominal power of the generating unit.  Used to give precise meaning to percentage based attributes such as the governor speed change droop (governorSCD attribute).
The attribute shall be a positive value equal or less than RotatingMachine.ratedS."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.ratedGrossMaxP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedGrossMaxP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The unit's gross rated maximum capacity (book value)."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.ratedGrossMinP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedGrossMinP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The gross rated minimum generation level which the unit can safely operate at while delivering power to the transmission grid."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.ratedNetMaxP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedNetMaxP"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The net rated maximum capacity determined by subtracting the auxiliary power used to operate the internal plant machinery from the rated gross maximum capacity."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.shortPF cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "shortPF"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Generating unit short term economic participation factor."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:GeneratingUnit.startupCost cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "startupCost"@en ;
	rdfs:domain cim:GeneratingUnit ;
	cims:dataType cim:Money ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The initial startup cost incurred for each start of the GeneratingUnit."^^rdf:XMLLiteral ;
	a rdf:Property .

