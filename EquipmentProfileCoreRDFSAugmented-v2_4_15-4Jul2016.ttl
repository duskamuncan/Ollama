cim:PhaseTapChangerAsymmetrical rdfs:label "PhaseTapChangerAsymmetrical"@en ;
	rdfs:subClassOf cim:PhaseTapChangerNonLinear ;
	rdfs:comment "Describes the tap model for an asymmetrical phase shifting transformer in which the difference voltage vector adds to the primary side voltage. The angle between the primary side voltage and the difference voltage is named the winding connection angle. The phase shift depends on both the difference voltage magnitude and the winding connection angle."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PhaseTapChangerAsymmetrical.windingConnectionAngle cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "windingConnectionAngle"@en ;
	rdfs:domain cim:PhaseTapChangerAsymmetrical ;
	cims:dataType cim:AngleDegrees ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The phase angle between the in-phase winding and the out-of -phase winding used for creating phase shift. The out-of-phase winding produces what is known as the difference voltage.  Setting this angle to 90 degrees is not the same as a symmemtrical transformer."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerLinear rdfs:label "PhaseTapChangerLinear"@en ;
	rdfs:subClassOf cim:PhaseTapChanger ;
	rdfs:comment """Describes a tap changer with a linear relation between the tap step and the phase angle difference across the transformer. This is a mathematical model that is an approximation of a real phase tap changer.
The phase angle is computed as stepPhaseShitfIncrement times the tap position.
The secondary side voltage magnitude is the same as at the primary side."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PhaseTapChangerLinear.stepPhaseShiftIncrement cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "stepPhaseShiftIncrement"@en ;
	rdfs:domain cim:PhaseTapChangerLinear ;
	cims:dataType cim:AngleDegrees ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """Phase shift per step position. A positive value indicates a positive phase shift from the winding where the tap is located to the other winding (for a two-winding transformer).
The actual phase shift increment might be more accurately computed from the symmetrical or asymmetrical models or a tap step table lookup if those are available."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerLinear.xMax cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "xMax"@en ;
	rdfs:domain cim:PhaseTapChangerLinear ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The reactance depend on the tap position according to a \"u\" shaped curve. The maximum reactance (xMax) appear at the low and high tap positions."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerLinear.xMin cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "xMin"@en ;
	rdfs:domain cim:PhaseTapChangerLinear ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The reactance depend on the tap position according to a \"u\" shaped curve. The minimum reactance (xMin) appear at the mid tap position."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerNonLinear rdfs:label "PhaseTapChangerNonLinear"@en ;
	rdfs:subClassOf cim:PhaseTapChanger ;
	rdfs:comment "The non-linear phase tap changer describes the non-linear behavior of a phase tap changer. This is a base class for the symmetrical and asymmetrical phase tap changer models. The details of these models can be found in the IEC 61970-301 document."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:PhaseTapChangerNonLinear.voltageStepIncrement cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "voltageStepIncrement"@en ;
	rdfs:domain cim:PhaseTapChangerNonLinear ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The voltage step increment on the out of phase winding specified in percent of nominal voltage of the transformer end."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerNonLinear.xMax cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "xMax"@en ;
	rdfs:domain cim:PhaseTapChangerNonLinear ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The reactance depend on the tap position according to a \"u\" shaped curve. The maximum reactance (xMax) appear at the low and high tap positions."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerNonLinear.xMin cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "xMin"@en ;
	rdfs:domain cim:PhaseTapChangerNonLinear ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The reactance depend on the tap position according to a \"u\" shaped curve. The minimum reactance (xMin) appear at the mid tap position."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerSymmetrical rdfs:label "PhaseTapChangerSymmetrical"@en ;
	rdfs:subClassOf cim:PhaseTapChangerNonLinear ;
	rdfs:comment "Describes a symmetrical phase shifting transformer tap model in which the secondary side voltage magnitude is the same as at the primary side. The difference voltage magnitude is the base in an equal-sided triangle where the sides corresponds to the primary and secondary voltages. The phase angle difference corresponds to the top angle and can be expressed as twice the arctangent of half the total difference voltage."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PhaseTapChangerTable rdfs:label "PhaseTapChangerTable"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "Describes a tabular curve for how the phase angle difference and impedance varies with the tap step."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PhaseTapChangerTablePoint.PhaseTapChangerTable rdfs:label "PhaseTapChangerTable"@en ;
	rdfs:comment "The table of this point."^^rdf:XMLLiteral ;
	rdfs:domain cim:PhaseTapChangerTablePoint ;
	rdfs:range cim:PhaseTapChangerTable ;
	cims:inverseRoleName cim:PhaseTapChangerTable.PhaseTapChangerTablePoint ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:PhaseTapChangerTable.PhaseTapChangerTablePoint rdfs:label "PhaseTapChangerTablePoint"@en ;
	rdfs:comment "The points of this table."^^rdf:XMLLiteral ;
	rdfs:domain cim:PhaseTapChangerTable ;
	rdfs:range cim:PhaseTapChangerTablePoint ;
	cims:inverseRoleName cim:PhaseTapChangerTablePoint.PhaseTapChangerTable ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:PhaseTapChangerTable.PhaseTapChangerTabular rdfs:label "PhaseTapChangerTabular"@en ;
	rdfs:comment "The phase tap changers to which this phase tap table applies."^^rdf:XMLLiteral ;
	rdfs:domain cim:PhaseTapChangerTable ;
	rdfs:range cim:PhaseTapChangerTabular ;
	cims:inverseRoleName cim:PhaseTapChangerTabular.PhaseTapChangerTable ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:PhaseTapChangerTabular.PhaseTapChangerTable rdfs:label "PhaseTapChangerTable"@en ;
	rdfs:comment "The phase tap changer table for this phase tap changer."^^rdf:XMLLiteral ;
	rdfs:domain cim:PhaseTapChangerTabular ;
	rdfs:range cim:PhaseTapChangerTable ;
	cims:inverseRoleName cim:PhaseTapChangerTable.PhaseTapChangerTabular ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:PhaseTapChangerTablePoint rdfs:label "PhaseTapChangerTablePoint"@en ;
	rdfs:subClassOf cim:TapChangerTablePoint ;
	rdfs:comment "Describes each tap step in the phase tap changer tabular curve."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PhaseTapChangerTablePoint.angle cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "angle"@en ;
	rdfs:domain cim:PhaseTapChangerTablePoint ;
	cims:dataType cim:AngleDegrees ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The angle difference in degrees."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PhaseTapChangerTabular rdfs:label "PhaseTapChangerTabular"@en ;
	rdfs:subClassOf cim:PhaseTapChanger ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PowerTransformer rdfs:label "PowerTransformer"@en ;
	rdfs:subClassOf cim:ConductingEquipment ;
	rdfs:comment """An electrical device consisting of  two or more coupled windings, with or without a magnetic core, for introducing mutual coupling between electric circuits. Transformers can be used to control voltage and phase shift (active power flow).
A power transformer may be composed of separate transformer tanks that need not be identical.
A power transformer can be modeled with or without tanks and is intended for use in both balanced and unbalanced representations.   A power transformer typically has two terminals, but may have one (grounding), three or more terminals.
The inherited association ConductingEquipment.BaseVoltage should not be used.  The association from TransformerEnd to BaseVoltage should be used instead."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PowerTransformerEnd.PowerTransformer rdfs:label "PowerTransformer"@en ;
	rdfs:comment "The ends of this power transformer."^^rdf:XMLLiteral ;
	rdfs:domain cim:PowerTransformerEnd ;
	rdfs:range cim:PowerTransformer ;
	cims:inverseRoleName cim:PowerTransformer.PowerTransformerEnd ;
	cims:multiplicity cims:M:1..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:PowerTransformer.PowerTransformerEnd rdfs:label "PowerTransformerEnd"@en ;
	rdfs:comment "The power transformer of this power transformer end."^^rdf:XMLLiteral ;
	rdfs:domain cim:PowerTransformer ;
	rdfs:range cim:PowerTransformerEnd ;
	cims:inverseRoleName cim:PowerTransformerEnd.PowerTransformer ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:PowerTransformerEnd rdfs:label "PowerTransformerEnd"@en ;
	rdfs:subClassOf cim:TransformerEnd ;
	rdfs:comment """A PowerTransformerEnd is associated with each Terminal of a PowerTransformer.
The impedance values r, r0, x, and x0 of a PowerTransformerEnd represents a star equivalent as follows
1) for a two Terminal PowerTransformer the high voltage PowerTransformerEnd has non zero values on r, r0, x, and x0 while the low voltage PowerTransformerEnd has zero values for r, r0, x, and x0.
2) for a three Terminal PowerTransformer the three PowerTransformerEnds represents a star equivalent with each leg in the star represented by r, r0, x, and x0 values.
3) for a PowerTransformer with more than three Terminals the PowerTransformerEnd impedance values cannot be used. Instead use the TransformerMeshImpedance or split the transformer into multiple PowerTransformers."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:PowerTransformerEnd.b cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "b"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:Susceptance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Magnetizing branch susceptance (B mag).  The value can be positive or negative."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerTransformerEnd.connectionKind cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "connectionKind"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	rdfs:range cim:WindingConnection ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Kind of connection."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:WindingConnection rdfs:label "WindingConnection"@en ;
	rdfs:comment "Winding connection type."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:WindingConnection.D rdfs:label "D"@en ;
	rdfs:comment "Delta"^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.Y rdfs:label "Y"@en ;
	rdfs:comment "Wye"^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.Z rdfs:label "Z"@en ;
	rdfs:comment "ZigZag"^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.Yn rdfs:label "Yn"@en ;
	rdfs:comment "Wye, with neutral brought out for grounding."^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.Zn rdfs:label "Zn"@en ;
	rdfs:comment "ZigZag, with neutral brought out for grounding."^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.A rdfs:label "A"@en ;
	rdfs:comment "Autotransformer common winding"^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:WindingConnection.I rdfs:label "I"@en ;
	rdfs:comment "Independent winding, for single-phase connections"^^rdf:XMLLiteral ;
	a cim:WindingConnection .

cim:PowerTransformerEnd.ratedS cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedS"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:ApparentPower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Normal apparent power rating.
The attribute shall be a positive value. For a two-winding transformer the values for the high and low voltage sides shall be identical. """^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerTransformerEnd.g cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "g"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:Conductance ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Magnetizing branch conductance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerTransformerEnd.ratedU cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedU"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """Rated voltage: phase-phase for three-phase windings, and either phase-phase or phase-neutral for single-phase windings.
A high voltage side, as given by TransformerEnd.endNumber, shall have a ratedU that is greater or equal than ratedU for the lower voltage sides."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerTransformerEnd.r cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:Resistance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """Resistance (star-model) of the transformer end.
The attribute shall be equal or greater than zero for non-equivalent transformers."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:PowerTransformerEnd.x cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x"@en ;
	rdfs:domain cim:PowerTransformerEnd ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence series reactance (star-model) of the transformer end."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ProtectedSwitch rdfs:label "ProtectedSwitch"@en ;
	rdfs:subClassOf cim:Switch ;
	rdfs:comment "A ProtectedSwitch is a switching device that can be operated by ProtectionEquipment."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:RatioTapChanger rdfs:label "RatioTapChanger"@en ;
	rdfs:subClassOf cim:TapChanger ;
	rdfs:comment "A tap changer that changes the voltage ratio impacting the voltage magnitude but not the phase angle across the transformer."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:RatioTapChanger.tculControlMode cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "tculControlMode"@en ;
	rdfs:domain cim:RatioTapChanger ;
	rdfs:range cim:TransformerControlMode ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Specifies the regulation control mode (voltage or reactive) of the RatioTapChanger."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TransformerControlMode rdfs:label "TransformerControlMode"@en ;
	rdfs:comment "Control modes for a transformer."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:TransformerControlMode.volt rdfs:label "volt"@en ;
	rdfs:comment "Voltage control"^^rdf:XMLLiteral ;
	a cim:TransformerControlMode .

cim:TransformerControlMode.reactive rdfs:label "reactive"@en ;
	rdfs:comment "Reactive power flow control"^^rdf:XMLLiteral ;
	a cim:TransformerControlMode .

cim:RatioTapChanger.stepVoltageIncrement cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "stepVoltageIncrement"@en ;
	rdfs:domain cim:RatioTapChanger ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Tap step increment, in per cent of nominal voltage, per step position."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:RatioTapChangerTable.RatioTapChanger rdfs:label "RatioTapChanger"@en ;
	rdfs:comment "The tap ratio table for this ratio  tap changer."^^rdf:XMLLiteral ;
	rdfs:domain cim:RatioTapChangerTable ;
	rdfs:range cim:RatioTapChanger ;
	cims:inverseRoleName cim:RatioTapChanger.RatioTapChangerTable ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:RatioTapChanger.RatioTapChangerTable rdfs:label "RatioTapChangerTable"@en ;
	rdfs:comment "The ratio tap changer of this tap ratio table."^^rdf:XMLLiteral ;
	rdfs:domain cim:RatioTapChanger ;
	rdfs:range cim:RatioTapChangerTable ;
	cims:inverseRoleName cim:RatioTapChangerTable.RatioTapChanger ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:RatioTapChanger.TransformerEnd rdfs:label "TransformerEnd"@en ;
	rdfs:comment "Ratio tap changer associated with this transformer end."^^rdf:XMLLiteral ;
	rdfs:domain cim:RatioTapChanger ;
	rdfs:range cim:TransformerEnd ;
	cims:inverseRoleName cim:TransformerEnd.RatioTapChanger ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:TransformerEnd.RatioTapChanger rdfs:label "RatioTapChanger"@en ;
	rdfs:comment "Transformer end to which this ratio tap changer belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:TransformerEnd ;
	rdfs:range cim:RatioTapChanger ;
	cims:inverseRoleName cim:RatioTapChanger.TransformerEnd ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:RatioTapChangerTable rdfs:label "RatioTapChangerTable"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "Describes a curve for how the voltage magnitude and impedance varies with the tap step. "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:RatioTapChangerTable.RatioTapChangerTablePoint rdfs:label "RatioTapChangerTablePoint"@en ;
	rdfs:comment "Table of this point."^^rdf:XMLLiteral ;
	rdfs:domain cim:RatioTapChangerTable ;
	rdfs:range cim:RatioTapChangerTablePoint ;
	cims:inverseRoleName cim:RatioTapChangerTablePoint.RatioTapChangerTable ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:RatioTapChangerTablePoint.RatioTapChangerTable rdfs:label "RatioTapChangerTable"@en ;
	rdfs:comment "Points of this table."^^rdf:XMLLiteral ;
	rdfs:domain cim:RatioTapChangerTablePoint ;
	rdfs:range cim:RatioTapChangerTable ;
	cims:inverseRoleName cim:RatioTapChangerTable.RatioTapChangerTablePoint ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:RatioTapChangerTablePoint rdfs:label "RatioTapChangerTablePoint"@en ;
	rdfs:subClassOf cim:TapChangerTablePoint ;
	rdfs:comment "Describes each tap step in the ratio tap changer tabular curve."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:ReactiveCapabilityCurve rdfs:label "ReactiveCapabilityCurve"@en ;
	rdfs:subClassOf cim:Curve ;
	rdfs:comment "Reactive power rating envelope versus the synchronous machine's active power, in both the generating and motoring modes. For each active power value there is a corresponding high and low reactive power limit  value. Typically there will be a separate curve for each coolant condition, such as hydrogen pressure.  The Y1 axis values represent reactive minimum and the Y2 axis values represent reactive maximum."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:EquivalentInjection.ReactiveCapabilityCurve rdfs:label "ReactiveCapabilityCurve"@en ;
	rdfs:comment "The equivalent injection using this reactive capability curve."^^rdf:XMLLiteral ;
	rdfs:domain cim:EquivalentInjection ;
	rdfs:range cim:ReactiveCapabilityCurve ;
	cims:inverseRoleName cim:ReactiveCapabilityCurve.EquivalentInjection ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ReactiveCapabilityCurve.EquivalentInjection rdfs:label "EquivalentInjection"@en ;
	rdfs:comment "The reactive capability curve used by this equivalent injection."^^rdf:XMLLiteral ;
	rdfs:domain cim:ReactiveCapabilityCurve ;
	rdfs:range cim:EquivalentInjection ;
	cims:inverseRoleName cim:EquivalentInjection.ReactiveCapabilityCurve ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:SynchronousMachine.InitialReactiveCapabilityCurve rdfs:label "InitialReactiveCapabilityCurve"@en ;
	rdfs:comment "Synchronous machines using this curve as default."^^rdf:XMLLiteral ;
	rdfs:domain cim:SynchronousMachine ;
	rdfs:range cim:ReactiveCapabilityCurve ;
	cims:inverseRoleName cim:ReactiveCapabilityCurve.InitiallyUsedBySynchronousMachines ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ReactiveCapabilityCurve.InitiallyUsedBySynchronousMachines rdfs:label "InitiallyUsedBySynchronousMachines"@en ;
	rdfs:comment "The default reactive capability curve for use by a synchronous machine."^^rdf:XMLLiteral ;
	rdfs:domain cim:ReactiveCapabilityCurve ;
	rdfs:range cim:SynchronousMachine ;
	cims:inverseRoleName cim:SynchronousMachine.InitialReactiveCapabilityCurve ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:RegulatingCondEq rdfs:label "RegulatingCondEq"@en ;
	rdfs:subClassOf cim:ConductingEquipment ;
	rdfs:comment "A type of conducting equipment that can regulate a quantity (i.e. voltage or flow) at a specific point in the network. "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:RegulatingCondEq.RegulatingControl rdfs:label "RegulatingControl"@en ;
	rdfs:comment "The regulating control scheme in which this equipment participates."^^rdf:XMLLiteral ;
	rdfs:domain cim:RegulatingCondEq ;
	rdfs:range cim:RegulatingControl ;
	cims:inverseRoleName cim:RegulatingControl.RegulatingCondEq ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:RegulatingControl.RegulatingCondEq rdfs:label "RegulatingCondEq"@en ;
	rdfs:comment "The equipment that participates in this regulating control scheme."^^rdf:XMLLiteral ;
	rdfs:domain cim:RegulatingControl ;
	rdfs:range cim:RegulatingCondEq ;
	cims:inverseRoleName cim:RegulatingCondEq.RegulatingControl ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:RegulatingControl rdfs:label "RegulatingControl"@en ;
	rdfs:subClassOf cim:PowerSystemResource ;
	rdfs:comment """Specifies a set of equipment that works together to control a power system quantity such as voltage or flow. 
Remote bus voltage control is possible by specifying the controlled terminal located at some place remote from the controlling equipment.
In case multiple equipment, possibly of different types, control same terminal there must be only one RegulatingControl at that terminal. The most specific subtype of RegulatingControl shall be used in case such equipment participate in the control, e.g. TapChangerControl for tap changers.
For flow control  load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:RegulatingControl.mode cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "mode"@en ;
	rdfs:domain cim:RegulatingControl ;
	rdfs:range cim:RegulatingControlModeKind ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The regulating control mode presently available.  This specification allows for determining the kind of regulation without need for obtaining the units from a schedule."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:RegulatingControlModeKind rdfs:label "RegulatingControlModeKind"@en ;
	rdfs:comment "The kind of regulation model.   For example regulating voltage, reactive power, active power, etc."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:RegulatingControlModeKind.voltage rdfs:label "voltage"@en ;
	rdfs:comment "Voltage is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.activePower rdfs:label "activePower"@en ;
	rdfs:comment "Active power is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.reactivePower rdfs:label "reactivePower"@en ;
	rdfs:comment "Reactive power is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.currentFlow rdfs:label "currentFlow"@en ;
	rdfs:comment "Current flow is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.admittance rdfs:label "admittance"@en ;
	rdfs:comment "Admittance is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.timeScheduled rdfs:label "timeScheduled"@en ;
	rdfs:comment "Control switches on/off by time of day. The times may change on the weekend, or in different seasons."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.temperature rdfs:label "temperature"@en ;
	rdfs:comment "Control switches on/off based on the local temperature (i.e., a thermostat)."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RegulatingControlModeKind.powerFactor rdfs:label "powerFactor"@en ;
	rdfs:comment "Power factor is specified."^^rdf:XMLLiteral ;
	a cim:RegulatingControlModeKind .

cim:RotatingMachine rdfs:label "RotatingMachine"@en ;
	rdfs:subClassOf cim:RegulatingCondEq ;
	rdfs:comment "A rotating machine which may be used as a generator or motor."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:RotatingMachine.ratedPowerFactor cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedPowerFactor"@en ;
	rdfs:domain cim:RotatingMachine ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Power factor (nameplate data). It is primarily used for short circuit data exchange according to IEC 60909."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:RotatingMachine.ratedS cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedS"@en ;
	rdfs:domain cim:RotatingMachine ;
	cims:dataType cim:ApparentPower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Nameplate apparent power rating for the unit.
The attribute shall have a positive value."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:RotatingMachine.ratedU cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedU"@en ;
	rdfs:domain cim:RotatingMachine ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Rated voltage (nameplate data, Ur in IEC 60909-0). It is primarily used for short circuit data exchange according to IEC 60909."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SeriesCompensator rdfs:label "SeriesCompensator"@en ;
	rdfs:subClassOf cim:ConductingEquipment ;
	rdfs:comment "A Series Compensator is a series capacitor or reactor or an AC transmission line without charging susceptance.  It is a two terminal device."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:SeriesCompensator.r cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r"@en ;
	rdfs:domain cim:SeriesCompensator ;
	cims:dataType cim:Resistance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence resistance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SeriesCompensator.x cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x"@en ;
	rdfs:domain cim:SeriesCompensator ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence reactance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SeriesCompensator.varistorPresent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "varistorPresent"@en ;
	rdfs:domain cim:SeriesCompensator ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Describe if a metal oxide varistor (mov) for over voltage protection is configured at the series compensator."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SeriesCompensator.varistorRatedCurrent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "varistorRatedCurrent"@en ;
	rdfs:domain cim:SeriesCompensator ;
	cims:dataType cim:CurrentFlow ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The maximum current the varistor is designed to handle at specified duration."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SeriesCompensator.varistorVoltageThreshold cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "varistorVoltageThreshold"@en ;
	rdfs:domain cim:SeriesCompensator ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The dc voltage at which the varistor start conducting."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShortCircuitRotorKind rdfs:label "ShortCircuitRotorKind"@en ;
	rdfs:comment "Type of rotor, used by short circuit applications."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:ShortCircuitRotorKind.salientPole1 rdfs:label "salientPole1"@en ;
	rdfs:comment "Salient pole 1 in the IEC 60909"^^rdf:XMLLiteral ;
	a cim:ShortCircuitRotorKind .

cim:ShortCircuitRotorKind.salientPole2 rdfs:label "salientPole2"@en ;
	rdfs:comment "Salient pole 2 in IEC 60909"^^rdf:XMLLiteral ;
	a cim:ShortCircuitRotorKind .

cim:ShortCircuitRotorKind.turboSeries1 rdfs:label "turboSeries1"@en ;
	rdfs:comment "Turbo Series 1 in the IEC 60909"^^rdf:XMLLiteral ;
	a cim:ShortCircuitRotorKind .

cim:ShortCircuitRotorKind.turboSeries2 rdfs:label "turboSeries2"@en ;
	rdfs:comment "Turbo series 2 in IEC 60909"^^rdf:XMLLiteral ;
	a cim:ShortCircuitRotorKind .

cim:ShuntCompensator rdfs:label "ShuntCompensator"@en ;
	rdfs:subClassOf cim:RegulatingCondEq ;
	rdfs:comment "A shunt capacitor or reactor or switchable bank of shunt capacitors or reactors. A section of a shunt compensator is an individual capacitor or reactor.  A negative value for reactivePerSection indicates that the compensator is a reactor. ShuntCompensator is a single terminal device.  Ground is implied."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:ShuntCompensator.aVRDelay cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "aVRDelay"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Seconds ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Time delay required for the device to be connected or disconnected by automatic voltage regulation (AVR)."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.grounded cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "grounded"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Used for Yn and Zn connections. True if the neutral is solidly grounded."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.maximumSections cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maximumSections"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The maximum number of sections that may be switched in. "^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.nomU cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "nomU"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The voltage at which the nominal reactive power may be calculated. This should normally be within 10% of the voltage at which the capacitor is connected to the network."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.normalSections cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "normalSections"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The normal number of sections switched in."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.switchOnCount cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "switchOnCount"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The switch on count since the capacitor count was last reset or initialized."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.switchOnDate cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "switchOnDate"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:DateTime ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The date and time when the capacitor bank was last switched on."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ShuntCompensator.voltageSensitivity cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "voltageSensitivity"@en ;
	rdfs:domain cim:ShuntCompensator ;
	cims:dataType cim:VoltagePerReactivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Voltage sensitivity required for the device to regulate the bus voltage, in voltage/reactive power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:VoltagePerReactivePower rdfs:label "VoltagePerReactivePower"@en ;
	rdfs:comment "Voltage variation with reactive power."^^rdf:XMLLiteral ;
	cims:stereotype "CIMDatatype" ;
	cims:belongsToCategory cim:Package_DomainProfile ;
	a rdfs:Class .

cim:VoltagePerReactivePower.value cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "value"@en ;
	rdfs:domain cim:VoltagePerReactivePower ;
	cims:dataType cim:Float ;
	cims:multiplicity cims:M:0..1 ;
	a rdf:Property .

cim:VoltagePerReactivePower.unit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "unit"@en ;
	rdfs:domain cim:VoltagePerReactivePower ;
	rdfs:range cim:UnitSymbol ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x79 .

_:node1jgf556j7x79 rdfs:Literal "V" .

cim:VoltagePerReactivePower.unit a rdf:Property .

cim:VoltagePerReactivePower.denominatorMultiplier cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "denominatorMultiplier"@en ;
	rdfs:domain cim:VoltagePerReactivePower ;
	rdfs:range cim:UnitMultiplier ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x80 .

_:node1jgf556j7x80 rdfs:Literal "M" .

cim:VoltagePerReactivePower.denominatorMultiplier a rdf:Property .

cim:VoltagePerReactivePower.multiplier cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "multiplier"@en ;
	rdfs:domain cim:VoltagePerReactivePower ;
	rdfs:range cim:UnitMultiplier ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x81 .

_:node1jgf556j7x81 rdfs:Literal "k" .

cim:VoltagePerReactivePower.multiplier a rdf:Property .

cim:VoltagePerReactivePower.denominatorUnit cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "denominatorUnit"@en ;
	rdfs:domain cim:VoltagePerReactivePower ;
	rdfs:range cim:UnitSymbol ;
	cims:multiplicity cims:M:0..1 ;
	cims:isFixed _:node1jgf556j7x82 .

_:node1jgf556j7x82 rdfs:Literal "VAr" .

cim:VoltagePerReactivePower.denominatorUnit a rdf:Property .

cim:StaticVarCompensator rdfs:label "StaticVarCompensator"@en ;
	rdfs:subClassOf cim:RegulatingCondEq ;
	rdfs:comment """A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer, filter, thyristor-controlled reactor, and thyristor-switched capacitor arms.

The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode, the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint.  The SVC characteristic slope defines the proportion.  If the voltage at the controlled bus is equal to the voltage setpoint, the SVC MVar output is zero."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:StaticVarCompensator.capacitiveRating cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "capacitiveRating"@en ;
	rdfs:domain cim:StaticVarCompensator ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Maximum available capacitive reactance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:StaticVarCompensator.inductiveRating cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "inductiveRating"@en ;
	rdfs:domain cim:StaticVarCompensator ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Maximum available inductive reactance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:StaticVarCompensator.slope cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "slope"@en ;
	rdfs:domain cim:StaticVarCompensator ;
	cims:dataType cim:VoltagePerReactivePower ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The characteristics slope of an SVC defines how the reactive power output changes in proportion to the difference between the regulated bus voltage and the voltage setpoint."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:StaticVarCompensator.sVCControlMode cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "sVCControlMode"@en ;
	rdfs:domain cim:StaticVarCompensator ;
	rdfs:range cim:SVCControlMode ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "SVC control mode."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SVCControlMode rdfs:label "SVCControlMode"@en ;
	rdfs:comment "Static VAr Compensator control mode."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:SVCControlMode.reactivePower rdfs:label "reactivePower"@en ;
	a cim:SVCControlMode .

cim:SVCControlMode.voltage rdfs:label "voltage"@en ;
	a cim:SVCControlMode .

cim:StaticVarCompensator.voltageSetPoint cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "voltageSetPoint"@en ;
	rdfs:domain cim:StaticVarCompensator ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The reactive power output of the SVC is proportional to the difference between the voltage at the regulated bus and the voltage setpoint.  When the regulated bus voltage is equal to the voltage setpoint, the reactive power output is zero."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Switch rdfs:label "Switch"@en ;
	rdfs:subClassOf cim:ConductingEquipment ;
	rdfs:comment "A generic device designed to close, or open, or both, one or more electric circuits.  All switches are two terminal devices including grounding switches."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:Switch.normalOpen cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "normalOpen"@en ;
	rdfs:domain cim:Switch ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The attribute is used in cases when no Measurement for the status value is present. If the Switch has a status measurement the Discrete.normalValue is expected to match with the Switch.normalOpen."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Switch.ratedCurrent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratedCurrent"@en ;
	rdfs:domain cim:Switch ;
	cims:dataType cim:CurrentFlow ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The maximum continuous current carrying capacity in amps governed by the device material and construction."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Switch.retained cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "retained"@en ;
	rdfs:domain cim:Switch ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Branch is retained in a bus branch model.  The flow through retained switches will normally be calculated in power flow."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SynchronousMachine rdfs:label "SynchronousMachine"@en ;
	rdfs:subClassOf cim:RotatingMachine ;
	rdfs:comment "An electromechanical device that operates with shaft rotating synchronously with the network. It is a single machine operating either as a generator or synchronous condenser or pump."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:SynchronousMachine.maxQ cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maxQ"@en ;
	rdfs:domain cim:SynchronousMachine ;
	cims:dataType cim:ReactivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Maximum reactive power limit. This is the maximum (nameplate) limit for the unit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SynchronousMachine.minQ cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "minQ"@en ;
	rdfs:domain cim:SynchronousMachine ;
	cims:dataType cim:ReactivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Minimum reactive power limit for the unit."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SynchronousMachine.qPercent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qPercent"@en ;
	rdfs:domain cim:SynchronousMachine ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Percent of the coordinated reactive control that comes from this machine."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SynchronousMachine.type cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "type"@en ;
	rdfs:domain cim:SynchronousMachine ;
	rdfs:range cim:SynchronousMachineKind ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Modes that this synchronous machine can operate in."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:SynchronousMachineKind rdfs:label "SynchronousMachineKind"@en ;
	rdfs:comment "Synchronous machine type."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:SynchronousMachineKind.generator rdfs:label "generator"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.condenser rdfs:label "condenser"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.generatorOrCondenser rdfs:label "generatorOrCondenser"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.motor rdfs:label "motor"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.generatorOrMotor rdfs:label "generatorOrMotor"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.motorOrCondenser rdfs:label "motorOrCondenser"@en ;
	a cim:SynchronousMachineKind .

cim:SynchronousMachineKind.generatorOrCondenserOrMotor rdfs:label "generatorOrCondenserOrMotor"@en ;
	a cim:SynchronousMachineKind .

cim:TapChanger rdfs:label "TapChanger"@en ;
	rdfs:subClassOf cim:PowerSystemResource ;
	rdfs:comment "Mechanism for changing transformer winding tap positions."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:TapChanger.highStep cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "highStep"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """Highest possible tap step position, advance from neutral.
The attribute shall be greater than lowStep."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChanger.lowStep cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "lowStep"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Lowest possible tap step position, retard from neutral"^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChanger.ltcFlag cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ltcFlag"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Specifies whether or not a TapChanger has load tap changing capabilities."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChanger.neutralStep cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "neutralStep"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """The neutral tap step position for this winding.
The attribute shall be equal or greater than lowStep and equal or less than highStep."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChanger.neutralU cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "neutralU"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Voltage ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Voltage at which the winding operates at the neutral tap setting."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChanger.normalStep cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "normalStep"@en ;
	rdfs:domain cim:TapChanger ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """The tap step position used in \"normal\" network operation for this winding. For a \"Fixed\" tap changer indicates the current physical tap setting.
The attribute shall be equal or greater than lowStep and equal or less than highStep."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerControl.TapChanger rdfs:label "TapChanger"@en ;
	rdfs:comment "The regulating control scheme in which this tap changer participates."^^rdf:XMLLiteral ;
	rdfs:domain cim:TapChangerControl ;
	rdfs:range cim:TapChanger ;
	cims:inverseRoleName cim:TapChanger.TapChangerControl ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:TapChanger.TapChangerControl rdfs:label "TapChangerControl"@en ;
	rdfs:comment "The tap changers that participates in this regulating tap control scheme."^^rdf:XMLLiteral ;
	rdfs:domain cim:TapChanger ;
	rdfs:range cim:TapChangerControl ;
	cims:inverseRoleName cim:TapChangerControl.TapChanger ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:TapChangerControl rdfs:label "TapChangerControl"@en ;
	rdfs:subClassOf cim:RegulatingControl ;
	rdfs:comment "Describes behavior specific to tap changers, e.g. how the voltage at the end of a line varies with the load level and compensation of the voltage drop by tap adjustment."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:TapChangerTablePoint rdfs:label "TapChangerTablePoint"@en ;
	cims:belongsToCategory cim:Package_Wires ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:TapChangerTablePoint.b cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "b"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """The magnetizing branch susceptance deviation in percent of nominal value. The actual susceptance is calculated as follows:
calculated magnetizing susceptance = b(nominal) * (1 + b(from this class)/100).   The b(nominal) is defined as the static magnetizing susceptance on the associated power transformer end or ends.  This model assumes the star impedance (pi model) form."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerTablePoint.g cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "g"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """The magnetizing branch conductance deviation in percent of nominal value. The actual conductance is calculated as follows:
calculated magnetizing conductance = g(nominal) * (1 + g(from this class)/100).   The g(nominal) is defined as the static magnetizing conductance on the associated power transformer end or ends.  This model assumes the star impedance (pi model) form."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerTablePoint.r cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """The resistance deviation in percent of nominal value. The actual reactance is calculated as follows:
calculated resistance = r(nominal) * (1 + r(from this class)/100).   The r(nominal) is defined as the static resistance on the associated power transformer end or ends.  This model assumes the star impedance (pi model) form."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerTablePoint.ratio cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "ratio"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "The voltage ratio in per unit. Hence this is a value close to one."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerTablePoint.step cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "step"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The tap step."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TapChangerTablePoint.x cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x"@en ;
	rdfs:domain cim:TapChangerTablePoint ;
	cims:dataType cim:PerCent ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """The series reactance deviation in percent of nominal value. The actual reactance is calculated as follows:
calculated reactance = x(nominal) * (1 + x(from this class)/100).   The x(nominal) is defined as the static series reactance on the associated power transformer end or ends.  This model assumes the star impedance (pi model) form."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:TransformerEnd rdfs:label "TransformerEnd"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "A conducting connection point of a power transformer. It corresponds to a physical transformer winding terminal.  In earlier CIM versions, the TransformerWinding class served a similar purpose, but this class is more flexible because it associates to terminal but is not a specialization of ConductingEquipment."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Wires ;
	a rdfs:Class .

cim:TransformerEnd.endNumber cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "endNumber"@en ;
	rdfs:domain cim:TransformerEnd ;
	cims:dataType cim:Integer ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Number for this transformer end, corresponding to the end's order in the power transformer vector group or phase angle clock number.  Highest voltage winding should be 1.  Each end within a power transformer should have a unique subsequent end number.   Note the transformer end number need not match the terminal sequence number."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Package_LoadModel rdfs:label "LoadModel"@en ;
	a cims:ClassCategory ;
	rdfs:comment """This package is responsible for modeling the energy consumers and the system load as curves and associated curve data. Special circumstances that may affect the load, such as seasons and daytypes, are also included here.

This information is used by Load Forecasting and Load Management."""^^rdf:XMLLiteral .

cim:ConformLoad rdfs:label "ConformLoad"@en ;
	rdfs:subClassOf cim:EnergyConsumer ;
	rdfs:comment "ConformLoad represent loads that follow a daily load change pattern where the pattern can be used to scale the load with a system load."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:ConformLoadGroup.EnergyConsumers rdfs:label "EnergyConsumers"@en ;
	rdfs:comment "Conform loads assigned to this ConformLoadGroup."^^rdf:XMLLiteral ;
	rdfs:domain cim:ConformLoadGroup ;
	rdfs:range cim:ConformLoad ;
	cims:inverseRoleName cim:ConformLoad.LoadGroup ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:ConformLoad.LoadGroup rdfs:label "LoadGroup"@en ;
	rdfs:comment "Group of this ConformLoad."^^rdf:XMLLiteral ;
	rdfs:domain cim:ConformLoad ;
	rdfs:range cim:ConformLoadGroup ;
	cims:inverseRoleName cim:ConformLoadGroup.EnergyConsumers ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ConformLoadGroup rdfs:label "ConformLoadGroup"@en ;
	rdfs:subClassOf cim:LoadGroup ;
	rdfs:comment "A group of loads conforming to an allocation pattern. "^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:ConformLoadGroup.ConformLoadSchedules rdfs:label "ConformLoadSchedules"@en ;
	rdfs:comment "The ConformLoadSchedules in the ConformLoadGroup."^^rdf:XMLLiteral ;
	rdfs:domain cim:ConformLoadGroup ;
	rdfs:range cim:ConformLoadSchedule ;
	cims:inverseRoleName cim:ConformLoadSchedule.ConformLoadGroup ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:ConformLoadSchedule.ConformLoadGroup rdfs:label "ConformLoadGroup"@en ;
	rdfs:comment "The ConformLoadGroup where the ConformLoadSchedule belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:ConformLoadSchedule ;
	rdfs:range cim:ConformLoadGroup ;
	cims:inverseRoleName cim:ConformLoadGroup.ConformLoadSchedules ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ConformLoadSchedule rdfs:label "ConformLoadSchedule"@en ;
	rdfs:subClassOf cim:SeasonDayTypeSchedule ;
	rdfs:comment "A curve of load  versus time (X-axis) showing the active power values (Y1-axis) and reactive power (Y2-axis) for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:LoadGroup rdfs:label "LoadGroup"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "The class is the third level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	a rdfs:Class .

cim:LoadResponseCharacteristic rdfs:label "LoadResponseCharacteristic"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment """Models the characteristic response of the load demand due to changes in system conditions such as voltage and frequency. This is not related to demand response.

If LoadResponseCharacteristic.exponentModel is True, the voltage exponents are specified and used as to calculate:

Active power component = Pnominal * (Voltage/cim:BaseVoltage.nominalVoltage) ** cim:LoadResponseCharacteristic.pVoltageExponent

Reactive power component = Qnominal * (Voltage/cim:BaseVoltage.nominalVoltage)** cim:LoadResponseCharacteristic.qVoltageExponent

Where  * means \"multiply\" and ** is \"raised to power of\"."""^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:LoadResponseCharacteristic.exponentModel cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "exponentModel"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment """Indicates the exponential voltage dependency model is to be used.   If false, the coefficient model is to be used.
The exponential voltage dependency model consist of the attributes
- pVoltageExponent
- qVoltageExponent.
The coefficient model consist of the attributes
- pConstantImpedance
- pConstantCurrent
- pConstantPower
- qConstantImpedance
- qConstantCurrent
- qConstantPower.
The sum of pConstantImpedance, pConstantCurrent and pConstantPower shall equal 1.
The sum of qConstantImpedance, qConstantCurrent and qConstantPower shall equal 1."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.pConstantCurrent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "pConstantCurrent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of active power load modeled as constant current."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.pConstantImpedance cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "pConstantImpedance"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of active power load modeled as constant impedance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.pConstantPower cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "pConstantPower"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of active power load modeled as constant power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.pFrequencyExponent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "pFrequencyExponent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Exponent of per unit frequency effecting active power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.pVoltageExponent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "pVoltageExponent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Exponent of per unit voltage effecting real power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.qConstantCurrent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qConstantCurrent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of reactive power load modeled as constant current."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.qConstantImpedance cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qConstantImpedance"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of reactive power load modeled as constant impedance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.qConstantPower cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qConstantPower"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Portion of reactive power load modeled as constant power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.qFrequencyExponent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qFrequencyExponent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Exponent of per unit frequency effecting reactive power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:LoadResponseCharacteristic.qVoltageExponent cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "qVoltageExponent"@en ;
	rdfs:domain cim:LoadResponseCharacteristic ;
	cims:dataType cim:Simple_Float ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Exponent of per unit voltage effecting reactive power."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:NonConformLoad rdfs:label "NonConformLoad"@en ;
	rdfs:subClassOf cim:EnergyConsumer ;
	rdfs:comment "NonConformLoad represent loads that do not follow a daily load change pattern and changes are not correlated with the daily load change pattern."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:NonConformLoad.LoadGroup rdfs:label "LoadGroup"@en ;
	rdfs:comment "Conform loads assigned to this ConformLoadGroup."^^rdf:XMLLiteral ;
	rdfs:domain cim:NonConformLoad ;
	rdfs:range cim:NonConformLoadGroup ;
	cims:inverseRoleName cim:NonConformLoadGroup.EnergyConsumers ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:NonConformLoadGroup.EnergyConsumers rdfs:label "EnergyConsumers"@en ;
	rdfs:comment "Group of this ConformLoad."^^rdf:XMLLiteral ;
	rdfs:domain cim:NonConformLoadGroup ;
	rdfs:range cim:NonConformLoad ;
	cims:inverseRoleName cim:NonConformLoad.LoadGroup ;
	cims:multiplicity cims:M:1..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:NonConformLoadGroup rdfs:label "NonConformLoadGroup"@en ;
	rdfs:subClassOf cim:LoadGroup ;
	rdfs:comment "Loads that do not follow a daily and seasonal load variation pattern."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:NonConformLoadGroup.NonConformLoadSchedules rdfs:label "NonConformLoadSchedules"@en ;
	rdfs:comment "The NonConformLoadSchedules in the NonConformLoadGroup."^^rdf:XMLLiteral ;
	rdfs:domain cim:NonConformLoadGroup ;
	rdfs:range cim:NonConformLoadSchedule ;
	cims:inverseRoleName cim:NonConformLoadSchedule.NonConformLoadGroup ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:NonConformLoadSchedule.NonConformLoadGroup rdfs:label "NonConformLoadGroup"@en ;
	rdfs:comment "The NonConformLoadGroup where the NonConformLoadSchedule belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:NonConformLoadSchedule ;
	rdfs:range cim:NonConformLoadGroup ;
	cims:inverseRoleName cim:NonConformLoadGroup.NonConformLoadSchedules ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:NonConformLoadSchedule rdfs:label "NonConformLoadSchedule"@en ;
	rdfs:subClassOf cim:SeasonDayTypeSchedule ;
	rdfs:comment "An active power (Y1-axis) and reactive power (Y2-axis) schedule (curves) versus time (X-axis) for non-conforming loads, e.g., large industrial load or power station service (where modeled)."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_LoadModel ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:MonthDay rdfs:label "MonthDay"@en ;
	rdfs:comment "MonthDay format as \"--mm-dd\", which conforms with XSD data type gMonthDay."^^rdf:XMLLiteral ;
	cims:stereotype "Primitive" ;
	cims:belongsToCategory cim:Package_DomainProfile ;
	a rdfs:Class .

cim:Package_Equivalents rdfs:label "Equivalents"@en ;
	a cims:ClassCategory ;
	rdfs:comment "The equivalents package models equivalent networks."^^rdf:XMLLiteral .

cim:EquivalentBranch rdfs:label "EquivalentBranch"@en ;
	rdfs:subClassOf cim:EquivalentEquipment ;
	rdfs:comment "The class represents equivalent branches."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Equivalents ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:EquivalentBranch.r cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r"@en ;
	rdfs:domain cim:EquivalentBranch ;
	cims:dataType cim:Resistance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence series resistance of the reduced branch."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentBranch.r21 cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "r21"@en ;
	rdfs:domain cim:EquivalentBranch ;
	cims:dataType cim:Resistance ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Resistance from terminal sequence 2 to terminal sequence 1 .Used for steady state power flow. This attribute is optional and represent unbalanced network such as off-nominal phase shifter. If only EquivalentBranch.r is given, then EquivalentBranch.r21 is assumed equal to EquivalentBranch.r.
Usage rule : EquivalentBranch is a result of network reduction prior to the data exchange."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentBranch.x cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x"@en ;
	rdfs:domain cim:EquivalentBranch ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence series reactance of the reduced branch."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentBranch.x21 cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "x21"@en ;
	rdfs:domain cim:EquivalentBranch ;
	cims:dataType cim:Reactance ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment """Reactance from terminal sequence 2 to terminal sequence 1 .Used for steady state power flow. This attribute is optional and represent unbalanced network such as off-nominal phase shifter. If only EquivalentBranch.x is given, then EquivalentBranch.x21 is assumed equal to EquivalentBranch.x.
Usage rule : EquivalentBranch is a result of network reduction prior to the data exchange."""^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentEquipment rdfs:label "EquivalentEquipment"@en ;
	rdfs:subClassOf cim:ConductingEquipment ;
	rdfs:comment "The class represents equivalent objects that are the result of a network reduction. The class is the base for equivalent objects of different types."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Equivalents ;
	a rdfs:Class .

cim:EquivalentNetwork.EquivalentEquipments rdfs:label "EquivalentEquipments"@en ;
	rdfs:comment "The equivalent where the reduced model belongs."^^rdf:XMLLiteral ;
	rdfs:domain cim:EquivalentNetwork ;
	rdfs:range cim:EquivalentEquipment ;
	cims:inverseRoleName cim:EquivalentEquipment.EquivalentNetwork ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:EquivalentEquipment.EquivalentNetwork rdfs:label "EquivalentNetwork"@en ;
	rdfs:comment "The associated reduced equivalents."^^rdf:XMLLiteral ;
	rdfs:domain cim:EquivalentEquipment ;
	rdfs:range cim:EquivalentNetwork ;
	cims:inverseRoleName cim:EquivalentNetwork.EquivalentEquipments ;
	cims:multiplicity cims:M:0..1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:EquivalentInjection rdfs:label "EquivalentInjection"@en ;
	rdfs:subClassOf cim:EquivalentEquipment ;
	rdfs:comment "This class represents equivalent injections (generation or load).  Voltage regulation is allowed only at the point of connection."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Equivalents ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:EquivalentInjection.maxP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maxP"@en ;
	rdfs:domain cim:EquivalentInjection ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Maximum active power of the injection."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentInjection.maxQ cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "maxQ"@en ;
	rdfs:domain cim:EquivalentInjection ;
	cims:dataType cim:ReactivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Used for modeling of infeed for load flow exchange. Not used for short circuit modeling.  If maxQ and minQ are not used ReactiveCapabilityCurve can be used.   "^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentInjection.minP cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "minP"@en ;
	rdfs:domain cim:EquivalentInjection ;
	cims:dataType cim:ActivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Minimum active power of the injection."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentInjection.minQ cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "minQ"@en ;
	rdfs:domain cim:EquivalentInjection ;
	cims:dataType cim:ReactivePower ;
	cims:multiplicity cims:M:0..1 ;
	rdfs:comment "Used for modeling of infeed for load flow exchange. Not used for short circuit modeling.  If maxQ and minQ are not used ReactiveCapabilityCurve can be used."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentInjection.regulationCapability cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "regulationCapability"@en ;
	rdfs:domain cim:EquivalentInjection ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Specifies whether or not the EquivalentInjection has the capability to regulate the local voltage."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentNetwork rdfs:label "EquivalentNetwork"@en ;
	rdfs:subClassOf cim:ConnectivityNodeContainer ;
	rdfs:comment "A class that represents an external meshed network that has been reduced to an electrically equivalent model. The ConnectivityNodes contained in the equivalent are intended to reflect internal nodes of the equivalent. The boundary Connectivity nodes where the equivalent connects outside itself are NOT contained by the equivalent."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Equivalents ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:EquivalentShunt rdfs:label "EquivalentShunt"@en ;
	rdfs:subClassOf cim:EquivalentEquipment ;
	rdfs:comment "The class represents equivalent shunts."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_Equivalents ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:EquivalentShunt.b cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "b"@en ;
	rdfs:domain cim:EquivalentShunt ;
	cims:dataType cim:Susceptance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence shunt susceptance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:EquivalentShunt.g cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "g"@en ;
	rdfs:domain cim:EquivalentShunt ;
	cims:dataType cim:Conductance ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "Positive sequence shunt conductance."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:Package_ControlArea rdfs:label "ControlArea"@en ;
	a cims:ClassCategory ;
	rdfs:comment "The ControlArea package models area specifications which can be used for a variety of purposes.  The package as a whole models potentially overlapping control area specifications for the purpose of actual generation control, load forecast area load capture, or powerflow based analysis."^^rdf:XMLLiteral .

cim:ControlArea rdfs:label "ControlArea"@en ;
	rdfs:subClassOf cim:PowerSystemResource ;
	rdfs:comment "A control area<b> </b>is a grouping of generating units and/or loads and a cutset of tie lines (as terminals) which may be used for a variety of purposes including automatic generation control, powerflow solution area interchange control specification, and input to load forecasting.   Note that any number of overlapping control area specifications can be superimposed on the physical model."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_ControlArea ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:ControlArea.type cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "type"@en ;
	rdfs:domain cim:ControlArea ;
	rdfs:range cim:ControlAreaTypeKind ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "The primary type of control area definition used to determine if this is used for automatic generation control, for planning interchange control, or other purposes.   A control area specified with primary type of automatic generation control could still be forecast and used as an interchange area in power flow analysis."^^rdf:XMLLiteral ;
	a rdf:Property .

cim:ControlAreaTypeKind rdfs:label "ControlAreaTypeKind"@en ;
	rdfs:comment "The type of control area."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_ControlArea ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#enumeration> ;
	a rdfs:Class .

cim:ControlAreaTypeKind.AGC rdfs:label "AGC"@en ;
	rdfs:comment "Used for automatic generation control."^^rdf:XMLLiteral ;
	a cim:ControlAreaTypeKind .

cim:ControlAreaTypeKind.Forecast rdfs:label "Forecast"@en ;
	rdfs:comment "Used for load forecast."^^rdf:XMLLiteral ;
	a cim:ControlAreaTypeKind .

cim:ControlAreaTypeKind.Interchange rdfs:label "Interchange"@en ;
	rdfs:comment "Used for interchange specification or control."^^rdf:XMLLiteral ;
	a cim:ControlAreaTypeKind .

cim:TieFlow.ControlArea rdfs:label "ControlArea"@en ;
	rdfs:comment "The control area of the tie flows."^^rdf:XMLLiteral ;
	rdfs:domain cim:TieFlow ;
	rdfs:range cim:ControlArea ;
	cims:inverseRoleName cim:ControlArea.TieFlow ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ControlArea.TieFlow rdfs:label "TieFlow"@en ;
	rdfs:comment "The tie flows associated with the control area."^^rdf:XMLLiteral ;
	rdfs:domain cim:ControlArea ;
	rdfs:range cim:TieFlow ;
	cims:inverseRoleName cim:TieFlow.ControlArea ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:ControlAreaGeneratingUnit.ControlArea rdfs:label "ControlArea"@en ;
	rdfs:comment "The parent control area for the generating unit specifications."^^rdf:XMLLiteral ;
	rdfs:domain cim:ControlAreaGeneratingUnit ;
	rdfs:range cim:ControlArea ;
	cims:inverseRoleName cim:ControlArea.ControlAreaGeneratingUnit ;
	cims:multiplicity cims:M:1 ;
	cims:AssociationUsed "Yes" ;
	a rdf:Property .

cim:ControlArea.ControlAreaGeneratingUnit rdfs:label "ControlAreaGeneratingUnit"@en ;
	rdfs:comment "The generating unit specificaitons for the control area."^^rdf:XMLLiteral ;
	rdfs:domain cim:ControlArea ;
	rdfs:range cim:ControlAreaGeneratingUnit ;
	cims:inverseRoleName cim:ControlAreaGeneratingUnit.ControlArea ;
	cims:multiplicity cims:M:0..n ;
	cims:AssociationUsed "No" ;
	a rdf:Property .

cim:ControlAreaGeneratingUnit rdfs:label "ControlAreaGeneratingUnit"@en ;
	rdfs:subClassOf cim:IdentifiedObject ;
	rdfs:comment "A control area generating unit. This class is needed so that alternate control area definitions may include the same generating unit.   Note only one instance within a control area should reference a specific generating unit."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_ControlArea ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:TieFlow rdfs:label "TieFlow"@en ;
	rdfs:comment "A flow specification in terms of location and direction for a control area."^^rdf:XMLLiteral ;
	cims:belongsToCategory cim:Package_ControlArea ;
	cims:stereotype <http://iec.ch/TC57/NonStandard/UML#concrete> ;
	a rdfs:Class .

cim:TieFlow.positiveFlowIn cims:stereotype <http://iec.ch/TC57/NonStandard/UML#attribute> ;
	rdfs:label "positiveFlowIn"@en ;
	rdfs:domain cim:TieFlow ;
	cims:dataType cim:Boolean ;
	cims:multiplicity cims:M:1..1 ;
	rdfs:comment "True if the flow into the terminal (load convention) is also flow into the control area.  For example, this attribute should be true if using the tie line terminal further away from the control area. For example to represent a tie to a shunt component (like a load or generator) in another area, this is the near end of a branch and this attribute would be specified as false."^^rdf:XMLLiteral ;
	a rdf:Property .
